{
  "name": "irisflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:compile": "node electron/build.mjs",
    "electron:dev": "node electron/dev.mjs",
    "electron:build": "npm run build && node electron/build.mjs && node electron/package-app.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "canvas": "^3.2.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "libsvm-js": "^0.2.1",
    "onnxruntime-node": "^1.20.0"
  },
  "build": {
    "appId": "com.irisflow.app",
    "productName": "IrisFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*.onnx"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "dist/mediapipe/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
