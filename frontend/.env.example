# =====================================================================
# IrisFlow desktop — variáveis de ambiente (frontend)
#
# Copie para frontend/.env.local e preencha. Sem estas variáveis o app roda
# 100% local: sem login, sem mensagens do cuidador, sem licença.
#
# São as MESMAS credenciais do site (SITE IRISFLOW V1/.env.local) e do app do
# cuidador (irisflow-cuidador/.env): um único projeto Supabase, "Site Iris Flow".
# Painel do Supabase > Project Settings > API.
# =====================================================================
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Edge Function por onde o desktop escreve. Só mude se hospedar a função
# fora do Supabase; o padrão é <VITE_SUPABASE_URL>/functions/v1/desktop-sync.
# VITE_DESKTOP_SYNC_URL=

# Endereço do site, mostrado nas telas de bloqueio ("gerencie a assinatura em…").
VITE_SITE_URL=https://irisflow.com.br

# Dias que uma licença já confirmada continua valendo sem internet.
VITE_LICENSE_OFFLINE_DAYS=7

# --- já existentes ---
# Backend de demonstração das telas de chatbot/voz (opcional).
# VITE_API_URL=http://localhost:8000/api
# PIN local da área do cuidador (temporário).
# VITE_CAREGIVER_PIN=1234
