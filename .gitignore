# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-electron
release
*.local

# Modelos treinados (binários grandes, não versionados)
resources/models/*.onnx
frontend/public/models/**/*.onnx

# Datasets e artefatos ML pesados
python_ml/datasets/
python_ml/.git/

# Scratch / experimentos externos
scratch/

# Relatórios de accuracy test auto-gerados na raiz pelo próprio pipeline
# (não são fixture, são snapshot ephemeral por sessão).
accuracy-report-*.json

# Validação de axis symmetry do L2CS.
# Fotos de referência (5 poses × ≥1 distância) e o axis_validation_report.json
# ficam localmente. Mesma lógica do ci-baseline.jsonl: biometria + tamanho não
# vão pro Git por padrão. Se precisar versionar (auditoria/repro), usar `git
# add -f frontend/python_scripts/l2cs_validation/<subdir>`.
frontend/python_scripts/l2cs_validation/

# Gravações de tela (referência visual/QA — pesadas, não versionadas)
*.mp4
*.mov
*.mkv
*.webm

# Claude Code
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntv's*
*.njsproj
*.sln
*.sw?

# Documentos de auditoria e planejamento (locais, não versionados por decisão
# do autor). Os IDs citados em comentários do código (C-xx, F-FE-xx, Q-xx,
# Exp-n) vivem nestes arquivos — mantenha-os no disco ao trabalhar no pipeline.
ARCHITECTURE.md
AUDIT.md
AUDIT-FRONTEND.md
BENCHMARKS.md
DECISIONS.md
PIPELINE.md
README-PROPOSED.md
